# =====================================================================
# 🚀 VELIXO AI WORK OS - MASTER ENVIRONMENT CONFIGURATION
# Copy this content into your .env file or deployment platform (Vercel / Render)
# =====================================================================

# ---------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Set on Vercel Dashboard)
# ---------------------------------------------------------------------
# Points React Frontend to Deployed FastAPI Backend Endpoint
VITE_API_URL=http://localhost:8000

# Firebase Cloud Messaging Key for Browser Push Notifications (Optional)
VITE_APP_FIREBASE_API_KEY=your_firebase_api_key_here

# ---------------------------------------------------------------------
# 2. DATABASE CONNECTION (Required for Backend & Live Data Persistence)
# ---------------------------------------------------------------------
DATABASE_URL=postgresql://neondb_owner:npg_ERJmtbgkO41Q@ep-solitary-shadow-az9g1d2n-pooler.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# ---------------------------------------------------------------------
# 3. AI PROVIDER API KEYS (At least 1 required - Gemini Recommended)
# ---------------------------------------------------------------------
# Google Gemini API (Primary Model): https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API (Ultra-fast Llama 3.3 70B): https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# OpenRouter API (Catalog Fallback): https://openrouter.ai
OPENROUTER_API_KEY=your_openrouter_api_key_here

# NVIDIA NIM API (Hosted Nemotron/Llama): https://build.nvidia.com
NVIDIA_API_KEY=your_nvidia_api_key_here

# OpenAI API Key (Optional): https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude Key (Optional): https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# AI Provider Mode: "auto", "gemini", "groq", "openrouter", "nvidia", "ollama", "mock"
PRIMARY_AI_PROVIDER=auto

# ---------------------------------------------------------------------
# 4. THIRD-PARTY INTEGRATION KEYS (Optional Features)
# ---------------------------------------------------------------------
# GitHub Token (for syncing PRs & issues): https://github.com/settings/tokens
GITHUB_TOKEN=your_github_personal_access_token_here

# Telegram Bot Token (for mobile push alerts): https://t.me/BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Google Cloud OAuth (for Calendar & Gmail sync): https://console.cloud.google.com
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ---------------------------------------------------------------------
# 5. BACKEND SERVICE SETTINGS
# ---------------------------------------------------------------------
PROJECT_NAME=Velixo AI Work OS
VERSION=1.0.0
API_V1_STR=/api
